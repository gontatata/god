<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>GOD 出目チェッカー</title>
    <%= csrf_meta_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
      body {
        background: linear-gradient(135deg, #0a0a1a 0%, #1a0a2e 50%, #0a1a0a 100%);
        min-height: 100vh;
        font-family: 'Hiragino Sans', 'Yu Gothic', sans-serif;
        color: #e0e0e0;
      }
      .god-title {
        font-size: 2.5rem; font-weight: 900;
        background: linear-gradient(90deg, #ffd700, #ff6b00, #ffd700);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        letter-spacing: 0.1em;
      }
      .god-subtitle { color: #aaa; font-size: 0.9rem; letter-spacing: 0.2em; }
      .card-god {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,215,0,0.3);
        border-radius: 16px; backdrop-filter: blur(10px);
      }
      .deme-input {
        background: rgba(0,0,0,0.5) !important;
        border: 2px solid rgba(255,215,0,0.5) !important;
        color: #ffd700 !important; font-size: 2rem !important;
        letter-spacing: 0.5em !important; text-align: center; font-weight: bold;
        text-transform: uppercase;
      }
      .deme-input::placeholder { color: rgba(255,215,0,0.3) !important; font-size: 1.2rem; }
      .deme-input:focus { box-shadow: 0 0 20px rgba(255,215,0,0.4) !important; }
      .btn-god {
        background: linear-gradient(135deg, #b8860b, #ffd700, #b8860b);
        color: #000; font-weight: 900; font-size: 1.1rem; letter-spacing: 0.1em;
        border: none; border-radius: 8px; padding: 12px 40px; transition: all 0.3s;
      }
      .btn-god:hover { transform: scale(1.05); box-shadow: 0 0 25px rgba(255,215,0,0.6); }
      .result-card { border-radius: 12px; padding: 1.5rem; margin-top: 1.5rem; animation: fadeIn 0.4s ease; }
      @keyframes fadeIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
      .result-reach      { background: linear-gradient(135deg,rgba(220,53,69,0.3),rgba(255,100,100,0.1)); border: 2px solid #dc3545; box-shadow: 0 0 20px rgba(220,53,69,0.4); }
      .result-v_mode     { background: linear-gradient(135deg,rgba(128,0,128,0.3),rgba(200,0,200,0.1)); border: 2px solid #cc00cc; box-shadow: 0 0 20px rgba(200,0,200,0.4); }
      .result-choutenoku { background: linear-gradient(135deg,rgba(255,193,7,0.3),rgba(255,215,0,0.1)); border: 2px solid #ffc107; box-shadow: 0 0 20px rgba(255,193,7,0.4); }
      .result-tenkou_short { background: linear-gradient(135deg,rgba(255,193,7,0.2),rgba(255,165,0,0.1)); border: 2px solid #fd7e14; box-shadow: 0 0 15px rgba(253,126,20,0.3); }
      .result-tenkou_prep  { background: linear-gradient(135deg,rgba(13,202,240,0.2),rgba(0,150,200,0.1)); border: 2px solid #0dcaf0; box-shadow: 0 0 15px rgba(13,202,240,0.3); }
      .result-gstop_strong { background: linear-gradient(135deg,rgba(25,135,84,0.3),rgba(0,200,100,0.1)); border: 2px solid #198754; box-shadow: 0 0 15px rgba(25,135,84,0.3); }
      .result-chance       { background: linear-gradient(135deg,rgba(25,135,84,0.2),rgba(0,180,80,0.1)); border: 2px solid #20c997; box-shadow: 0 0 10px rgba(32,201,151,0.2); }
      .result-gstop_weak   { background: linear-gradient(135deg,rgba(108,117,125,0.2),rgba(150,150,150,0.1)); border: 1px solid #6c757d; }
      .result-normal       { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); }
      .result-deme  { font-size: 3rem; font-weight: 900; letter-spacing: 0.4em; }
      .result-label { font-size: 1.4rem; font-weight: 700; letter-spacing: 0.1em; }
      .result-desc  { font-size: 1rem; opacity: 0.85; }
      .nickname-badge { font-size: 0.85rem; background: rgba(255,215,0,0.2); color: #ffd700; padding: 3px 12px; border-radius: 20px; border: 1px solid rgba(255,215,0,0.4); }
      .legend-table th, .legend-table td { font-size: 0.78rem; padding: 4px 8px; border-color: rgba(255,255,255,0.1) !important; color: #ccc; }
      .legend-table th { color: #ffd700; background: rgba(255,215,0,0.05); }
      .figure-btn { width: 52px; height: 52px; font-size: 1.3rem; font-weight: bold; margin: 3px; border-radius: 8px; }
      .reel-display { display: flex; justify-content: center; gap: 8px; margin: 1rem 0; }
      .reel-slot {
        width: 80px; height: 80px; background: rgba(0,0,0,0.6);
        border: 2px solid rgba(255,215,0,0.4); border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem; font-weight: 900; color: #ffd700;
        cursor: pointer; transition: all 0.2s;
      }
      .reel-slot:hover { border-color: #ffd700; box-shadow: 0 0 15px rgba(255,215,0,0.5); }
      .reel-slot.active { border-color: #ff6b6b; box-shadow: 0 0 15px rgba(255,100,100,0.5); background: rgba(255,50,50,0.1); }
      .picker-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 0.5rem 0; }
    </style>
  </head>
  <body>
    <%= yield %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
